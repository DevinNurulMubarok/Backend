generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         Int      @id @default(autoincrement())
  name       String
  email      String   @unique
  password   String
  profilePic String?
  role       Role
  gender     Gender
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("users")
}

model Address {
  id   Int  @id @default(autoincrement())
  street String
  city   String
  createAt DateTime @default(now())
  updateAt  DateTime @updatedAt

  @@map("addresses")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum Gender {
  MALE     
  FEMALE    
}